{
  "name": "@arc-sim/core",
  "version": "0.1.0",
  "description": "Deterministic American football play-by-play simulation engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx examples/sim-demo.ts",
    "demo:render": "vite",
    "dist-check": "tsx scripts/dist-check.ts",
    "gen:golden": "tsx scripts/gen-v1-golden.ts",
    "verify": "pnpm type-check && pnpm test && pnpm build && pnpm dist-check",
    "prepublishOnly": "pnpm verify"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.2.0",
    "vitest": "^3.0.9"
  }
}
